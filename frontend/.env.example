# Server-side only. None of these is exposed to the browser (no NEXT_PUBLIC_ variables).
# Copy to .env.local for development. Never commit real values.

# Public origin of the recon API (what customers call with API keys). Informational for this app: the BFF does NOT use it.
RECON_API_BASE_URL=https://api.recon.example

# INTERNAL listener of the recon API (RECON_INTERNAL_BIND on the API side). The BFF proxies same-origin
# /api/bff/v1/* to ${RECON_API_INTERNAL_URL}/v1/* (allowlisted GET routes only). That listener only accepts source IPs
# in the API's RECON_INTERNAL_ALLOWED_CIDRS and requests signed with the service key below. Keep it on a private network.
RECON_API_INTERNAL_URL=http://recon-api.internal:8081

# Service signing key (scheme RECON-SVC-V1). The same id and secret must be listed in the API's RECON_SERVICE_KEYS as
# `<id>:<secret>`. Id: 1-32 characters of a-z 0-9 and "-". Secret: base64url of at least 32 random bytes. To rotate: add the
# new key to the API's RECON_SERVICE_KEYS, switch these two values, then remove the old key from the API.
# Generate:  node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
RECON_SERVICE_KEY_ID=bff-1
RECON_SERVICE_KEY_SECRET=

# OIDC issuer (EU-hosted IdP). Discovery is read from ${OIDC_ISSUER}/.well-known/openid-configuration. Must be https.
OIDC_ISSUER=https://idp.recon.example/realms/recon
OIDC_CLIENT_ID=recon-web
# Optional. Leave empty for a public client (PKCE is always used).
OIDC_CLIENT_SECRET=
# Optional, default "openid". Add whatever scope/audience your IdP needs to issue an access token the API accepts.
OIDC_SCOPE=openid

# Public origin of this app, no trailing path. The IdP redirect URI to register is ${APP_BASE_URL}/api/auth/callback
APP_BASE_URL=https://app.recon.example

# base64url of exactly 32 random bytes; encrypts the session and login-flow cookies (AES-256-GCM).
# Generate:  node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
