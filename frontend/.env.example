# Server-side only. None of these is exposed to the browser (no NEXT_PUBLIC_ variables).
# Copy to .env.local for development. Never commit real values.

# Base URL of the recon API (Axum). The BFF proxies same-origin /api/bff/v1/* to ${RECON_API_BASE_URL}/v1/*.
RECON_API_BASE_URL=https://api.recon.example

# OIDC issuer (EU-hosted IdP). Discovery is read from ${OIDC_ISSUER}/.well-known/openid-configuration. Must be https.
OIDC_ISSUER=https://idp.recon.example/realms/recon
OIDC_CLIENT_ID=recon-web
# Optional. Leave empty for a public client (PKCE is always used).
OIDC_CLIENT_SECRET=
# Optional, default "openid". Add whatever scope/audience your IdP needs to issue an access token the API accepts.
OIDC_SCOPE=openid

# Public origin of this app, no trailing path. The IdP redirect URI to register is ${APP_BASE_URL}/api/auth/callback
APP_BASE_URL=https://app.recon.example

# base64url of exactly 32 random bytes; encrypts the session and login-flow cookies (AES-256-GCM).
# Generate:  node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
